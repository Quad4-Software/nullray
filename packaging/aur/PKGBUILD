# Maintainer: Quad4 Software <ivan@quad4.io>
# shellcheck disable=SC2034
pkgname=nullray-bin
pkgver=0.1.1
pkgrel=1
pkgdesc="Lightweight terminal AI coding agent (prebuilt binary)"
arch=('x86_64')
url="https://github.com/Quad4-Software/nullray"
license=('0BSD')
depends=('curl')
provides=('nullray')
conflicts=('nullray')
source=(
  "nullray_${pkgver}_linux_amd64.tar.gz::${url}/releases/download/v${pkgver}/nullray_${pkgver}_linux_amd64.tar.gz"
  "checksums.txt::${url}/releases/download/v${pkgver}/checksums.txt"
)
sha256sums=('SKIP' 'SKIP')

prepare() {
  local expected
  expected="$(awk -v f="nullray_${pkgver}_linux_amd64.tar.gz" '$2==f || $2=="./"f {print $1; exit}' checksums.txt)"
  [[ -n "$expected" ]] || { echo "missing checksum entry" >&2; return 1; }
  echo "${expected}  nullray_${pkgver}_linux_amd64.tar.gz" | sha256sum -c -
}

package() {
  install -Dm755 "nullray_${pkgver}_linux_amd64" "${pkgdir}/usr/bin/nullray"
}
